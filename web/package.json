{
  "name": "experts21-sparring-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web app for Richelin's healthcare services M&A sparring team",
  "scripts": {
    "build:team": "node scripts/build-team.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run build:team && npm run typecheck && vite build",
    "dev": "npm run build:team && vite",
    "test": "npm run build:team && node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@netlify/blobs": "^11.1.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "yaml": "^2.9.1"
  },
  "engines": { "node": ">=22" }
}
